{
  "name": "auction-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Umut Guney Koksal",
  "description": "Football Card Auction Game — frontend (proprietary; see LICENSE in repo root)",
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "browserslist": "^4.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "react-scripts": "5.0.1",
    "react-soccer-lineup": "^1.0.0-beta.10",
    "serve": "^14.2.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:prod": "serve -s build -l tcp://0.0.0.0:$PORT",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "eject": "react-scripts eject"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/features/**/*.ts",
      "src/shared/api/**/*.ts",
      "src/shared/realtime/eventDispatch.ts",
      "src/shared/realtime/transportFactory.ts",
      "src/shared/realtime/constants.ts",
      "src/shared/realtime/syncConstants.ts",
      "src/shared/session.ts",
      "src/shared/formations.ts",
      "src/shared/positions.ts",
      "!src/**/*.d.ts",
      "!src/**/model/**",
      "!src/features/**/useAuctionPageState.ts",
      "!src/features/**/useSpectateMatchReplay.ts",
      "!src/features/**/useLobbyFlow.ts",
      "!src/features/**/useAuctionOrchestrator.ts",
      "!src/features/**/useMatchFlow.ts",
      "!src/shared/realtime/eventDispatch.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85,
        "branches": 75,
        "functions": 80,
        "statements": 85
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
